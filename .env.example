# ===== Mode / chain =====
# paper   = read mainnet data, simulate fills against paper balances (no key needed)
# testnet = real txs on Monad testnet (10143); needs PRIVATE_KEY + testnet addresses below
# fork    = real txs on a local anvil mainnet fork (FORK_RPC_URL, localhost only); see pnpm fork
# testnet is NOT useful (no Uniswap/Pancake on Monad testnet)
# live    = real txs on Monad mainnet; needs PRIVATE_KEY and CONFIRM_LIVE=true
MODE=paper
CONFIRM_LIVE=false
CHAIN=monad
DEX=pancakeswap-v3
# Optional RPC override (default comes from the chain config)
RPC_URL=https://rpc.monad.xyz
FORK_UPSTREAM_RPC=https://rpc.monad.xyz
FORK_RPC_URL=http://127.0.0.1:8545
# Wallet key (testnet/live only). NEVER commit a real key.
PRIVATE_KEY=

# ===== Pair =====
# BASE_TOKEN: "native", a known symbol (WMON, WBTC, cbBTC, USDC) or a 0x token address. DEX: uniswap-v3 | pancakeswap-v3
BASE_TOKEN=native
QUOTE_TOKEN=USDC
# Testnet addresses are UNVERIFIED in-repo: supply them here when MODE=testnet
WRAPPED_NATIVE_ADDRESS=
UNISWAP_V3_FACTORY=
UNISWAP_V3_ROUTER=
UNISWAP_V3_QUOTER=

# ===== Decision engine =====
# jev = TypeSafe System One; mock = random/fixed (no API key)
DECISION_ENGINE=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# mock engine only
MOCK_MODE=random
MOCK_ACTION=hold

# ===== Loop / data =====
POLL_INTERVAL_SEC=60
# Send to the decision engine only if price moved > this many bps, balances changed, or heartbeat elapsed
CHANGE_THRESHOLD_BPS=15
HEARTBEAT_SEC=900
# GeckoTerminal candle cache (API limit is ~30 req/min)
CANDLE_REFRESH_SEC=300
GECKO_NETWORK=
# Optional; otherwise derived from the DEX pool address
GECKO_POOL=
# Stop after N ticks (smoke tests); empty = run forever
MAX_TICKS=
# Fallback probe size (whole BASE units) used to read prices when balances are ~0
PROBE_BASE_FALLBACK=1
SWAP_GAS_UNITS=300000

# ===== Paper mode =====
# Initial balances in whole units (only seeded once, then persisted in the DB)
PAPER_BALANCE_BASE=1000
PAPER_BALANCE_QUOTE=10
PAPER_BALANCE_NATIVE=10
# Avg entry price (QUOTE per BASE) if no cost basis exists; else current price is used
INITIAL_COST_BASIS=

# ===== Risk (final veto) =====
MIN_CONFIDENCE=0.6
# Native balance never dropped below this (whole native units).
# Monad reserve balance: EOAs must keep 10 MON or txs can revert under async execution
# (https://docs.monad.xyz/developer-essentials/reserve-balance) -> 10 + 0.5 buffer
GAS_RESERVE_NATIVE=10.5
# Trade size as % of available input asset
SIZE_SMALL_PCT=5
SIZE_MEDIUM_PCT=10
SIZE_LARGE_PCT=20
# Sell only if price >= entry*(1 + this%) + gas per unit (quote is already net of pool fee)
MIN_PROFIT_PCT=0.5
# Stop-loss does NOT force a sell: it only allows a sell below the profit target (when the model chooses sell)
# at price <= entry*(1 - this%). 0 disables
STOP_LOSS_PCT=3
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_BPS=50
# Minimum trade value in QUOTE units
MIN_TRADE_VALUE=0.5
# Hard cap per trade in QUOTE units (amount is clamped down); 0 disables
MAX_TRADE_VALUE=17
# Gas must be below this % of trade value
MAX_GAS_COST_PCT=2
TRADE_COOLDOWN_SEC=300
MAX_TRADES_PER_DAY=10
# Rolling-24h realized loss vs portfolio value (0 disables)
MAX_DAILY_LOSS_PCT=3
# Ladder: another sell needs the price >= this % above the last sell (another buy: this % below the last buy). 0 disables
SAME_SIDE_STEP_PCT=0.5

# ===== Misc =====
DB_PATH=./data/btrade.db
LOG_LEVEL=info

# ===== Reporting =====
# USD valuation (reporting only): onchain | off
USD_ORACLE=onchain
# Min seconds between portfolio_snapshots rows
PORTFOLIO_SNAPSHOT_SEC=300

# External flows: negative native balance changes down to this many native units are treated as gas, not withdrawals
FLOW_TOLERANCE_NATIVE=0.5
